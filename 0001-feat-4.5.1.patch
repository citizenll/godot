+                    // 标记为脏
+                    if (stream.wxfd && WXMEMFS.openStreams[stream.wxfd]) {
+                        WXMEMFS.openStreams[stream.wxfd].dirty = true;
+                    }
+
+                    return length;
+                } else if (position + length <= node.usedBytes) {
+                    node.contents.set(buffer.subarray(offset, offset + length), position);
