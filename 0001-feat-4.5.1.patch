+                    if (stream.wxfd && WXMEMFS.openStreams[stream.wxfd]) {
+                        WXMEMFS.openStreams[stream.wxfd].dirty = true;
+                    }
+
+                    return length;
+                } else if (node.usedBytes === 0 && position === 0) {
+                    node.contents = buffer.slice(offset, offset + length);
+                    node.usedBytes = length;
